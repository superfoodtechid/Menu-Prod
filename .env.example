# Server Configuration
PORT=18800
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://168.144.143.203:3000

# Backend Security Credentials
API_SECRET_KEY=foodmaster-secret-api-key-2026

# Discord notifications for completed Menu Push C5 jobs (Discord webhook URL)
WEBHOOK_URL=

# Google Drive Service Account Configuration
# Either provide base64/JSON string directly in GDRIVE_SERVICE_ACCOUNT_KEY or file path in GDRIVE_SERVICE_ACCOUNT_JSON
GDRIVE_SERVICE_ACCOUNT_KEY=
GDRIVE_SERVICE_ACCOUNT_JSON=service_account.json
# Root Google Drive folder for owner directories
GDRIVE_FOLDER_ID=14EFVOjND6brFT6BKdXu5dWJBErbSMqie
# Toggle automatic menu photo collection to Google Drive during Pull jobs (true/false)
ENABLE_GDRIVE_PHOTO_SYNC=true

# GoFood browser fallback and isolated extraction timeout
HEADLESS_GOFOOD=true
GOFOOD_EXTRACTION_TIMEOUT_SECONDS=900
PULL_EXTRACTION_TIMEOUT_SECONDS=900


